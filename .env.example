# ============================================================
#  Atlas 7.0 — environment template
#  Copy this file to ".env" and fill in the values you need.
#  Never commit the real ".env" file.
#
#  Windows:      Copy-Item .env.example .env
#  macOS/Linux:  cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# AI providers (at least one is recommended)
# ------------------------------------------------------------
# Primary AI. Free key: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional extra Gemini keys. Atlas rotates through them when
# one key hits a quota limit.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Backup AI. Free key: https://console.groq.com/
GROQ_KEY_1=
# GROQ_KEY_2=
# GROQ_KEY_3=
# GROQ_KEY_4=
# GROQ_KEY_5=
# GROQ_KEY_6=
# GROQ_KEY_7=
# GROQ_KEY_8=
# GROQ_KEY_9=
# GROQ_KEY_10=

# Which provider to try first: "gemini" or "groq"
AI_PRIMARY=gemini

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# Dashboard PIN. Change this before exposing Atlas anywhere.
AUTH_PIN=123456

# How Atlas addresses you.
USER_NAME=Boss

DEBUG=False
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Optional data providers
# ------------------------------------------------------------
# Weather: https://www.weatherapi.com/
WEATHER_API_KEY=

# Malware lookups: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# Breach checks: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Headlines: https://newsapi.org/
NEWS_API_KEY=

# ------------------------------------------------------------
# Email Triage Agent (IMAP)
# Gmail: enable 2-Step Verification, then create an App Password.
# ------------------------------------------------------------
ATLAS_IMAP_HOST=
ATLAS_IMAP_USER=
ATLAS_IMAP_PASS=
ATLAS_IMAP_PORT=993
ATLAS_IMAP_FOLDER=INBOX
ATLAS_IMAP_SSL=1

# ------------------------------------------------------------
# Voice
# Set to 0 to disable continuous wake-word listening
# (recommended on servers and in Docker).
# ------------------------------------------------------------
ATLAS_VOICE_AUTOSTART=1

# ------------------------------------------------------------
# Cloud relay and laptop pairing
# On a cloud server set ATLAS_CLOUD=1 and a long random
# ATLAS_PAIR_TOKEN. Use the same token in the connector:
#   python connector/atlas_laptop.py --server <url> --token <token>
# ------------------------------------------------------------
ATLAS_CLOUD=0
ATLAS_PAIR_TOKEN=

# ------------------------------------------------------------
# Telephony (future: real AI receptionist calls)
# Without these, the receptionist runs in simulator mode.
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ATLAS_VIRTUAL_NUMBER=

# ------------------------------------------------------------
# Optional speech providers
# ------------------------------------------------------------
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
